@using AITrade.Market

@if (Recommendation is not null)
{
    <span class="badge @BadgeClass" title="Score @Recommendation.Score.ToString("+0.00;-0.00;0.00") · @Recommendation.Confidence confidence">@Recommendation.ActionLabel</span>
    @if (ShowConfidence)
    {
        <span class="small text-muted ms-1">@Recommendation.Confidence</span>
    }
    @if (Recommendation.IsStale)
    {
        <span class="badge text-bg-warning ms-1" title="Latest price is from @Recommendation.AsOf.ToString("d"). Refresh prices.">Stale</span>
    }
}

@code {
    [Parameter, EditorRequired]
    public Recommendation? Recommendation { get; set; }

    [Parameter]
    public bool ShowConfidence { get; set; } = true;

    private string BadgeClass => Recommendation?.Action switch
    {
        RecommendedAction.Buy or RecommendedAction.BuyMore => "text-bg-success",
        RecommendedAction.Sell => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
